digraph K {
  graph [rankdir=TB, nodesep=0.25, ranksep=0.45, fontname="Times New Roman", fontsize=12, compound=true];
  node [shape=box, fontname="Times New Roman", fontsize=11, margin="0.10,0.05"];
  edge [fontname="Times New Roman", fontsize=9, arrowsize=0.7, color="#444444"];
  subgraph cluster_src { label="Источники данных"; style=rounded; color="#888888";
    uchet [label="Учётная система\nорганизации", style="filled,dashed", fillcolor="#ffffff"];
    baza [label="База закупок\nPostgreSQL", shape=cylinder, style="filled", fillcolor="#e8f0e0"];
  }
  subgraph cluster_sppr { label="Компонент sppr"; style=rounded; color="#3b6ea5";
    zagr [label="Загрузка данных\n(db)", style="filled", fillcolor="#dbe5f1"];
    klass [label="Классы ABC и XYZ\n(klassy)", style="filled", fillcolor="#dbe5f1"];
    zap [label="Точка перезаказа,\nэкономичная партия\n(zapasy)", style="filled", fillcolor="#dbe5f1"];
    ves [label="Веса критериев\nметодом анализа иерархий\n(ahp)", style="filled", fillcolor="#dbe5f1"];
    rejt [label="Рейтинг поставщиков\n(rejting)", style="filled", fillcolor="#dbe5f1"];
    plan [label="Проект заказа,\nпредел доли поставщика\n(plan)", style="filled", fillcolor="#dbe5f1"];
    param [label="Параметры:\nматрица, допуски, предел", style="filled", fillcolor="#dbe5f1"];
  }
  subgraph cluster_out { label="Результаты"; style=rounded; color="#888888";
    csv [label="Проект заказа\nи рейтинг (CSV)", style="filled", fillcolor="#dbe5f1"];
    status [label="Сводка состояния\n(status.json)", style="filled", fillcolor="#dbe5f1"];
    ui [label="Экран проверки\nпроекта заказа", style="filled,dashed", fillcolor="#ffffff"];
  }
  men [label="Менеджер\nпо закупкам", shape=box, style="rounded,filled", fillcolor="#fdebd0"];
  vlad [label="Владелец процесса", shape=box, style="rounded,filled", fillcolor="#fdebd0"];
  uchet -> baza [label="выгрузка", style=dashed];
  baza -> zagr;
  zagr -> klass; zagr -> zap; zagr -> rejt;
  klass -> zap [label="уровень\nобслуживания"];
  param -> ves; ves -> rejt [label="веса"];
  rejt -> plan [label="лучший\nпоставщик"]; zap -> plan;
  plan -> csv; plan -> status; plan -> baza [label="оценки", constraint=false];
  csv -> ui [style=dashed]; csv -> men; ui -> men [style=dashed];
  vlad -> param;
}
