<bpmn:messageFlow id="MessageFlow_44" name="Товар&#10;и УПД" sourceRef="Activity_25" targetRef="Participant_07" />
</bpmn:collaboration>
<bpmn:process id="Process_02" name="Закупка, приём и оптовая реализация товаров" isExecutable="false">
<bpmn:laneSet id="LaneSet_Process_02">
<bpmn:lane id="Lane_03" name="Менеджер по закупкам"><bpmn:flowNodeRef>Event_08</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_11</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_12</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_15</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_16</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_18</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_19</bpmn:flowNodeRef></bpmn:lane>
