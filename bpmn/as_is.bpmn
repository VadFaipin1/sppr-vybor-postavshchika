<bpmn:lane id="Lane_05" name="Менеджер по продажам"><bpmn:flowNodeRef>Activity_25</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_26</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Event_08" name="Начало&#10;недели&#10;планирования"><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:timerEventDefinition id="EventDefinition_09" /></bpmn:startEvent>
<bpmn:dataStoreReference id="DataStoreReference_10" name="Учётная&#10;система"></bpmn:dataStoreReference>
<bpmn:userTask id="Activity_11" name="Выгрузить остатки и историю продаж"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing><bpmn:property id="Property_38" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DataInputAssociation_37"><bpmn:sourceRef>DataStoreReference_10</bpmn:sourceRef><bpmn:targetRef>Property_38</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:manualTask id="Activity_12" name="Определить позиции к пополнению"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_39"><bpmn:targetRef>DataObjectReference_13</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:manualTask>
<bpmn:dataObjectReference id="DataObjectReference_13" name="Таблица&#10;расчёта&#10;потребности" dataObjectRef="DataObject_14"></bpmn:dataObjectReference><bpmn:dataObject id="DataObject_14" />
<bpmn:exclusiveGateway id="Gateway_15" name="Пополнение&#10;требуется?"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Event_16" name="Закупка не&#10;требуется"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:cancelEventDefinition id="EventDefinition_17" /></bpmn:endEvent>
<bpmn:subProcess id="Activity_18" name="Сформировать заказ поставщику"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:subProcess>
<bpmn:sendTask id="Activity_19" name="Разместить заказ у поставщика"><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_33</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_40"><bpmn:targetRef>DataObjectReference_20</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:sendTask>
<bpmn:dataObjectReference id="DataObjectReference_20" name="Заказ&#10;поставщику" dataObjectRef="DataObject_21"></bpmn:dataObjectReference><bpmn:dataObject id="DataObject_21" />
<bpmn:intermediateCatchEvent id="Event_22" name="Поставка&#10;прибыла"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing><bpmn:messageEventDefinition id="EventDefinition_23" /></bpmn:intermediateCatchEvent>
<bpmn:subProcess id="Activity_24" name="Принять и оприходовать партию"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:subProcess>
<bpmn:subProcess id="Activity_25" name="Отгрузить товар клиенту"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing></bpmn:subProcess>
<bpmn:endEvent id="Event_26" name="Товар&#10;отгружен,&#10;расчёты&#10;закрыты"><bpmn:incoming>Flow_36</bpmn:incoming></bpmn:endEvent>
