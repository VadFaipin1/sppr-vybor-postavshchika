<bpmn:collaboration id="Collaboration_podbor_as_is">
<bpmn:participant id="Participant_01" name="Сформировать заказ поставщику" processRef="Process_02" />
<bpmn:participant id="Participant_05" name="Поставщик" />
<bpmn:messageFlow id="MessageFlow_28" name="Запрос&#10;предложений" sourceRef="Activity_07" targetRef="Participant_05" />
<bpmn:messageFlow id="MessageFlow_29" name="Коммерческие&#10;предложения" sourceRef="Participant_05" targetRef="Event_08" />
</bpmn:collaboration>
<bpmn:process id="Process_02" name="Сформировать заказ поставщику" isExecutable="false">
<bpmn:laneSet id="LaneSet_Process_02">
<bpmn:lane id="Lane_03" name="Менеджер по закупкам"><bpmn:flowNodeRef>Event_06</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_07</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_08</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_10</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_11</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_16</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_17</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_04" name="Руководитель отдела закупок"><bpmn:flowNodeRef>Activity_12</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_13</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_14</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Event_06" name="Потребность&#10;определена"><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="Activity_07" name="Запросить коммерческие предложения"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="Event_08" name="Предложения&#10;получены"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:messageEventDefinition id="EventDefinition_09" /></bpmn:intermediateCatchEvent>
<bpmn:manualTask id="Activity_10" name="Выбрать поставщика по цене"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="Gateway_11" name="Сумма выше&#10;лимита?"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Activity_12" name="Согласовать закупку"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_13" name="Согласовано?"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Event_14" name="Заказ&#10;отклонён"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:cancelEventDefinition id="EventDefinition_15" /></bpmn:endEvent>
<bpmn:exclusiveGateway id="Gateway_16" name="Закупка&#10;разрешена"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Event_17" name="Заказ&#10;сформирован"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>
